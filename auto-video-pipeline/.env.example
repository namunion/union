# ==============================================================
# FILE CẤU HÌNH MẪU CHO AUTO VIDEO PIPELINE
# Đổi tên file này thành .env trên VPS và điền các thông tin của bạn
# ==============================================================

# 1. API AI (Trí tuệ nhân tạo)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# 2. CẤU HÌNH LỊCH CHẠY (Giờ trong ngày theo định dạng 24h, cách nhau dấu phẩy)
# Ví dụ: 8,12,18 là chạy lúc 8:00 sáng, 12:00 trưa và 18:00 tối
SCHEDULE_HOURS=8,12,18
TIMEZONE=Asia/Ho_Chi_Minh

# 3. NGUỒN VIDEO
# Danh sách URL kênh Youtube (cách nhau bởi dấu phẩy) để lấy video ngẫu nhiên khi input/ trống
YOUTUBE_CHANNELS=https://www.youtube.com/@Channel1,https://www.youtube.com/@Channel2
# Danh sách RSS Feed video (cách nhau bởi dấu phẩy) nếu YouTube không khả dụng
RSS_FEEDS=https://example.com/feed.xml

# 4. THÔNG SỐ RENDER VIDEO
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
SUBTITLE_FONT_PATH=assets/fonts/BeVietnamPro-Bold.ttf
SUBTITLE_FONT_SIZE=24
SUBTITLE_PRIMARY_COLOR=&H00FFFFFF
SUBTITLE_OUTLINE_COLOR=&H00000000

# 5. FACEBOOK GRAPH API (Đăng lên 3 Fanpage)
# Điền Page ID và Page Access Token của từng page
FB_PAGE_1_ID=your_page_1_id
FB_PAGE_1_TOKEN=your_page_1_access_token

FB_PAGE_2_ID=your_page_2_id
FB_PAGE_2_TOKEN=your_page_2_access_token

FB_PAGE_3_ID=your_page_3_id
FB_PAGE_3_TOKEN=your_page_3_access_token

# 6. THƯ MỤC HỆ THỐNG
INPUT_DIR=input
OUTPUT_DIR=output
POSTED_DIR=output/posted
LOGS_DIR=logs
ASSETS_DIR=assets
